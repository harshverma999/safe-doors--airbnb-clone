<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Listing</title>
</head>
<body>
    <form method="post" action="/listings/<%=prevData.id%>?_method=PUT">
        <input value="<%=prevData.title%>" type="text" name="prevData[title]"> <br><br>
        <textarea name="prevData[description]"><%=prevData.description%></textarea> <br><br>
        <input value="<%=prevData.price%>" type="number" name="prevData[price]"> <br><br>
        <input value="<%=prevData.location%>" type="text" name="prevData[location]"> <br><br>
        <input value="<%=prevData.country%>" type="text" name="prevData[country]"> <br><br>
        <button>submit</button>
    </form>
</body>
</html>