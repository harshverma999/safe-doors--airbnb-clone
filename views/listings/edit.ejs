<% layout('/layouts/boilerplate') %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h2>Edit Your Listing</h2>

    <form method="post" action="/listings/<%=prevData.id%>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="title">Title</label>
            <input class="form-control" value="<%=prevData.title%>" type="text" name="prevData[title]" required>
            <div class="invalid-feedback">Please enter a title.</div>
        </div>
        <div class="mb-3">
            <label for="description">Description</label>
            <textarea class="form-control" name="prevData[description]" required><%=prevData.description%></textarea>
            <div class="invalid-feedback">Please enter a description.</div>
        </div>
        <div class="mb-3">
            <label for="image">Image</label>
            <input class="form-control" type="text" value="<%=prevData.image%>" name="prevData[image]" required>
            <div class="invalid-feedback">Please enter an image link.</div>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price">Price</label>
            <input class="form-control" value="<%=prevData.price%>" type="number" name="prevData[price]" required>
            <div class="invalid-feedback">Please enter a price.</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country">Country</label>
            <input class="form-control" value="<%=prevData.country%>" type="text" name="prevData[country]" required>
            <div class="invalid-feedback">Please enter a country.</div>
        </div>
        </div>
        
        <div class="mb-3">
            <label for="location">Location</label>
            <input class="form-control" value="<%=prevData.location%>" type="text" name="prevData[location]" required>
            <div class="invalid-feedback">Please enter a location.</div>
        </div>

        <button class="btn btn-dark mb-3 edit-btn">Edit</button>
    </form>
    </div>
    </div>
