<% layout('/layouts/boilerplate') %>

<div class="row mt-3">
    <div class="col-8 offset-2">
            <h2>Create a New Listing</h2>
    <form method="post" action="/listings">
        <div class="mb-3">
            <label for="title" >Title</label>
            <input type="text" class="form-control" name="listing[title]" placeholder="Add a catchy title">
        </div>
        <div class="mb-3">
            <label for="description" >Description</label>
            <textarea class="form-control" name="listing[description]" placeholder="Enter description"></textarea>
        </div>
        <div class="mb-3">
            <label for="image" >Image Link</label>
            <input class="form-control" type="text" placeholder="Enter image URL/Link">
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" >Price</label>
            <input class="form-control" type="number" name="listing[price]" placeholder="1299">
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" >Country</label>
            <input class="form-control" type="text" name="listing[country]" placeholder="India">
        </div>

        </div>
        <div class="mb-3">
            <label for="location" >Location</label>
            <input class="form-control" type="text" name="listing[location]" placeholder="Roorkee, Uttarakhand">
        </div>
        <button class="btn btn-dark add-btn mb-3">Add</button>
    </form>
    </div>
    </div>
